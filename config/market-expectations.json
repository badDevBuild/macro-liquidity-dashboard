{
  "schema_version": "1.1",
  "provider": {
    "id": "polymarket_gamma",
    "label": "Polymarket",
    "authority": "prediction_market",
    "base_url": "https://gamma-api.polymarket.com",
    "public_url": "https://polymarket.com",
    "documentation_url": "https://docs.polymarket.com/developers/gamma-markets-api/overview"
  },
  "request": {
    "timeout_seconds": 25,
    "max_results_per_type": 10
  },
  "featured_markets": {
    "label": "高成交宏观盘口",
    "max_items": 5,
    "max_items_per_query": 2,
    "max_results_per_query": 12,
    "minimum_liquidity_usd": 5000,
    "minimum_volume_24h_usd": 500,
    "maximum_age_hours": 36,
    "queries": [
      {
        "query": "Fed decision",
        "label": "下一次美联储议息决定",
        "display_label": "下一次美联储议息决定",
        "topic_kind": "fed_decision",
        "title_pattern": "^Fed Decision in [A-Za-z]+\\?$"
      },
      {
        "query": "Treasury yield",
        "label": "美债收益率区间预期",
        "display_label": "美债收益率区间预期",
        "topic_kind": "treasury_yield",
        "title_pattern": "^How (high|low) will (5|10|30)-year Treasury yield"
      },
      {
        "query": "US government shutdown",
        "label": "停摆与众议院选举组合盘口",
        "display_label": "停摆与众议院选举组合盘口",
        "topic_kind": "government_shutdown",
        "title_pattern": "US government shutdown"
      },
      {
        "query": "US unemployment",
        "label": "美国就业与失业率预期",
        "display_label": "美国就业与失业率预期",
        "topic_kind": "us_unemployment",
        "title_pattern": "(US unemployment|US economic state)"
      },
      {
        "query": "US GDP",
        "label": "美国 GDP 增速预期",
        "display_label": "美国 GDP 增速预期",
        "topic_kind": "us_gdp",
        "title_pattern": "US GDP growth"
      },
      {
        "query": "US tariffs",
        "label": "美国关税政策预期",
        "display_label": "美国关税政策预期",
        "topic_kind": "us_tariffs",
        "title_pattern": "(tariff|tariffs)"
      }
    ]
  },
  "topics": [
    {
      "topic_id": "fed_policy_distribution",
      "label": "全年美联储降息次数",
      "query": "Fed rate cuts",
      "title_pattern": "^How many Fed rate cuts in [0-9]{4}\\?$",
      "presentation": "distribution",
      "policy_action": "cut",
      "target_year": "current",
      "require_neg_risk": true,
      "maximum_age_hours": 36,
      "optional": true,
      "minimum_liquidity_usd": 10000,
      "minimum_volume_24h_usd": 1000
    },
    {
      "topic_id": "fed_hike_distribution",
      "label": "全年美联储加息次数",
      "query": "Fed rate hikes",
      "title_pattern": "^How many Fed rate hikes in [0-9]{4}\\?$",
      "presentation": "distribution",
      "policy_action": "hike",
      "target_year": "current",
      "require_neg_risk": true,
      "maximum_age_hours": 36,
      "optional": true,
      "minimum_liquidity_usd": 10000,
      "minimum_volume_24h_usd": 1000
    },
    {
      "topic_id": "us_inflation_distribution",
      "label": "下一次美国年度通胀",
      "query": "Inflation US Annual",
      "title_pattern": "Inflation US - Annual$",
      "presentation": "distribution",
      "minimum_liquidity_usd": 5000,
      "minimum_volume_24h_usd": 500
    },
    {
      "topic_id": "us_recession_probability",
      "label": "美国在年内进入衰退",
      "query": "US recession",
      "title_pattern": "^US recession by end of [0-9]{4}\\?$",
      "presentation": "binary",
      "minimum_liquidity_usd": 5000,
      "minimum_volume_24h_usd": 100
    }
  ],
  "cme_fedwatch": {
    "label": "利率市场的美联储押注",
    "status": "credential_required",
    "source_name": "CME FedWatch / CME DataMine",
    "source_url": "https://www.cmegroup.com/markets/interest-rates/cme-fedwatch-tool.html",
    "message": "官方结构化数据需要 CME DataMine 凭证；当前不使用网页抓取，也不填入猜测值。"
  }
}
